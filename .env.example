# --- Routing -------------------------------------------------------------
# Works out of the box WITHOUT any key (keyless Valhalla demo server, fair use only).
# Optional: openrouteservice for better quality + green/quiet weighting.
# Free key: https://openrouteservice.org/dev/#/signup  (2000 directions/day on the free plan)
# ROUTING_PROVIDER=ors            # ors | valhalla (default: ors when ORS_API_KEY is set, else valhalla)
# ORS_API_KEY=
# ORS_URL=https://api.openrouteservice.org     # or your self-hosted ORS
# VALHALLA_URL=https://valhalla1.openstreetmap.de   # point to your own Valhalla for production

# --- Places (OpenStreetMap Overpass) -------------------------------------
# Comma separated, tried in order. Public instances are shared: use your own for production.
# OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter

# --- Address search (Nominatim) ------------------------------------------
# Public Nominatim requires a identifying User-Agent with contact details.
# NOMINATIM_USER_AGENT=RondjeHardlopen/1.0 (you@example.com)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODE_COUNTRIES=nl,be          # empty = worldwide

# --- Map tiles (browser) -------------------------------------------------
# The default tile.openstreetmap.org is for light use only. Use a tile provider in production.
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Strava (upload van je opgenomen run) --------------------------------
# Maak een app op https://www.strava.com/settings/api ; "Authorization Callback Domain" = je domein (lokaal: localhost)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback   # standaard: <origin>/api/strava/callback


# --- Foto's (alleen voor scripts/fetch-photos.mts) -----------------------
# Gratis demo-sleutel op https://unsplash.com/developers  ->  npx tsx scripts/fetch-photos.mts
# UNSPLASH_ACCESS_KEY=
# NEXT_PUBLIC_CATEGORY_PHOTOS=1   # zet aan nadat de foto's in public/img/categories staan
